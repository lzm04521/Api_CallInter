<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <AssemblyName>ApiCallInter</AssemblyName>
    <ApplicationIcon>ApiCallInter.ico</ApplicationIcon>
    <!-- 单文件发布：托管程序集+原生库全部打包进 ApiCallInter.exe；PDB 内嵌避免松散 .pdb；wwwroot 走程序集嵌入清单（见下方 EmbeddedResource） -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- 仅取其 build targets 生成嵌入清单（GenerateEmbeddedFilesManifest 的 targets 随此包分发）；运行时类型由上方 AspNetCore.App 共享框架提供 -->
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="update.ps1"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>
  <!-- UpdateService.ParseLatest 为 internal，测试需直测解析逻辑 -->
  <ItemGroup>
    <InternalsVisibleTo Include="ApiCallInter.Tests" />
  </ItemGroup>
  <!-- 内容根已固定为输出目录（Program.cs）；wwwroot 嵌入程序集由 ManifestEmbeddedFileProvider 提供（单文件发布不物理分发，普通构建同样可用） -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>
</Project>
